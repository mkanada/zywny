<?xml version="1.0" encoding="UTF-8"?>
<!-- O tipo dos pacotes `.zywny` (bibliotecas de músicas e cursos). Instalado
     por tool/install_linux.sh em ~/.local/share/mime/packages/. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-zywny">
    <comment>Zywny package</comment>
    <comment xml:lang="pt">Pacote do Zywny</comment>
    <comment xml:lang="pt_BR">Pacote do Zywny (biblioteca de músicas ou curso)</comment>
    <sub-class-of type="application/octet-stream"/>
    <!-- O envelope começa por "ZYWN" (docs/plano/B00): vale mesmo se o arquivo
         for renomeado. -->
    <magic priority="60">
      <match type="string" value="ZYWN" offset="0"/>
    </magic>
    <glob pattern="*.zywny"/>
    <icon name="zywny"/>
  </mime-type>
</mime-info>
